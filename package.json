{
  "name": "fast-github-review",
  "description": "A fast review UI for GitHub pull requests.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "test:e2e:only": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pierre/diffs": "1.3.6",
    "jsonc-parser": "3.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "smol-toml": "1.8.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "web-ext": "^10.5.0",
    "wxt": "0.21.4"
  }
}
