{
  "name": "gh-ext",
  "version": "2.1.0",
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "tls": {
      "enabled": true,
      "minVersion": "1.3"
    },
    "timeouts": {
      "readMs": 5000,
      "writeMs": 5000,
      "idleMs": 30000
    }
  },
  "features": [
    "diffs",
    "threads",
    "checks",
    "commits"
  ],
  "logging": {
    "level": "debug",
    "sinks": [
      "stdout"
    ]
  }
}
