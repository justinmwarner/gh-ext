{
  "name": "gh-ext",
  "version": "2.0.4",
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "tls": {
      "enabled": true,
      "minVersion": "1.2"
    },
    "timeouts": {
      "readMs": 5000,
      "writeMs": 5000
    }
  },
  "features": [
    "diffs",
    "threads",
    "checks"
  ],
  "logging": {
    "level": "info",
    "sinks": [
      "stdout"
    ]
  },
  "deprecated": {
    "legacyApi": true
  }
}
